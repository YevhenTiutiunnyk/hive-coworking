{
  "name": "hive-coworking",
  "version": "0.1.0",
  "private": true,
  "description": "Hive Coworking: a WordPress block theme and plugin.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=plugins/hive-core/blocks --output-path=plugins/hive-core/build --experimental-modules",
    "start": "wp-scripts start --webpack-src-dir=plugins/hive-core/blocks --output-path=plugins/hive-core/build --experimental-modules",
    "lint:js": "wp-scripts lint-js plugins/hive-core/blocks tests/e2e playwright.config.js",
    "lint:css": "wp-scripts lint-style \"plugins/hive-core/blocks/**/*.scss\" \"themes/hive/assets/css/*.css\"",
    "test:js": "wp-scripts test-unit-js plugins/hive-core/blocks",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "test:unit": "composer test:unit",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/hive-dev vendor/bin/phpunit -c plugins/hive-core/phpunit.xml.dist",
    "i18n": "tools/i18n/build.sh",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@wordpress/block-editor": "^18.1.0",
    "@wordpress/blocks": "^16.2.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/core-data": "^8.2.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/env": "^11.17.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/interactivity": "^7.0.0",
    "@wordpress/interactivity-router": "^2.57.0",
    "@wordpress/scripts": "^36.1.0",
    "@wordpress/server-side-render": "^6.33.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
