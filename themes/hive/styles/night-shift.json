{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Night Shift",
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Paper",
					"slug": "base",
					"color": "#16120D"
				},
				{
					"name": "Paper Shade",
					"slug": "base-2",
					"color": "#221C15"
				},
				{
					"name": "Ink",
					"slug": "contrast",
					"color": "#F5EEDF"
				},
				{
					"name": "Ink Soft",
					"slug": "contrast-2",
					"color": "#B9AE9C"
				},
				{
					"name": "Line",
					"slug": "contrast-3",
					"color": "#3A3128"
				},
				{
					"name": "Honey",
					"slug": "accent",
					"color": "#F2B33D"
				},
				{
					"name": "Amber",
					"slug": "accent-2",
					"color": "#F2B33D"
				},
				{
					"name": "Text on Honey",
					"slug": "accent-contrast",
					"color": "#16120D"
				},
				{
					"name": "Error",
					"slug": "error",
					"color": "#FF8F87"
				},
				{
					"name": "Success",
					"slug": "success",
					"color": "#7DD99A"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 1px 2px rgb(0 0 0 / 30%), 0 12px 32px -12px rgb(0 0 0 / 60%)"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}
