{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"name": "Paper",
					"slug": "base",
					"color": "#FBF7EF"
				},
				{
					"name": "Paper Shade",
					"slug": "base-2",
					"color": "#F3ECDD"
				},
				{
					"name": "Ink",
					"slug": "contrast",
					"color": "#211B14"
				},
				{
					"name": "Ink Soft",
					"slug": "contrast-2",
					"color": "#5E554A"
				},
				{
					"name": "Line",
					"slug": "contrast-3",
					"color": "#DDD3C2"
				},
				{
					"name": "Honey",
					"slug": "accent",
					"color": "#E8A317"
				},
				{
					"name": "Amber",
					"slug": "accent-2",
					"color": "#8A5300"
				},
				{
					"name": "Text on Honey",
					"slug": "accent-contrast",
					"color": "#211B14"
				},
				{
					"name": "Error",
					"slug": "error",
					"color": "#A4262C"
				},
				{
					"name": "Success",
					"slug": "success",
					"color": "#1D7A3A"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"name": "XS",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "S",
					"slug": "30",
					"size": "1rem"
				},
				{
					"name": "M",
					"slug": "40",
					"size": "clamp(1.25rem, 2vw, 1.75rem)"
				},
				{
					"name": "L",
					"slug": "50",
					"size": "clamp(1.75rem, 3.5vw, 3rem)"
				},
				{
					"name": "XL",
					"slug": "60",
					"size": "clamp(2.5rem, 6vw, 5rem)"
				},
				{
					"name": "XXL",
					"slug": "70",
					"size": "clamp(3.5rem, 9vw, 8rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Literata",
					"slug": "display",
					"fontFamily": "Literata, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-cyrillic-ext-opsz-normal.woff2"
							],
							"unicodeRange": "U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-cyrillic-opsz-normal.woff2"
							],
							"unicodeRange": "U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-latin-ext-opsz-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-latin-opsz-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-cyrillic-ext-opsz-italic.woff2"
							],
							"unicodeRange": "U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-cyrillic-opsz-italic.woff2"
							],
							"unicodeRange": "U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-latin-ext-opsz-italic.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/literata-latin-opsz-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						}
					]
				},
				{
					"name": "Onest",
					"slug": "body",
					"fontFamily": "Onest, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/onest-cyrillic-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F"
						},
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/onest-cyrillic-wght-normal.woff2"
							],
							"unicodeRange": "U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116"
						},
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/onest-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Onest",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/onest-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					}
				},
				{
					"name": "Huge",
					"slug": "xx-large",
					"size": "2.75rem",
					"fluid": {
						"min": "2rem",
						"max": "3.25rem"
					}
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "5.75rem"
					}
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 1px 2px rgb(33 27 20 / 6%), 0 8px 24px -8px rgb(33 27 20 / 14%)"
				}
			]
		},
		"custom": {
			"radius": {
				"small": "8px",
				"medium": "16px",
				"large": "28px",
				"pill": "999px"
			},
			"transition": "180ms cubic-bezier(0.2, 0.7, 0.2, 1)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "560",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-2)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.85em",
						"bottom": "0.85em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent-2)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast-2)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--contrast-3)"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--contrast-3)",
						"width": "1px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic",
					"lineHeight": "1.45"
				},
				"border": {
					"left": {
						"width": "0"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Page (wide, no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
