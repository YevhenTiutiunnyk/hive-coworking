{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "command -v zip >/dev/null || dnf install -y zip; npm ci",
  "buildCommand": "npm run package && node tools/playground/build-site.mjs",
  "outputDirectory": "dist/site",
  "headers": [
    {
      "source": "/(.*)\\.(zip|json)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
