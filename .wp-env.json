{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "phpVersion": "8.3",
  "plugins": ["./plugins/hive-core"],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true
  },
  "env": {
    "development": {
      "port": 8888
    },
    "tests": {
      "port": 8889,
      "mappings": {
        "wp-content/hive-dev": "."
      }
    }
  }
}
