{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hive/upcoming-events",
	"version": "0.1.0",
	"title": "Upcoming Events",
	"category": "widgets",
	"icon": "calendar",
	"description": "The next events, with an Add to calendar link for each.",
	"keywords": [ "events", "calendar", "meetup" ],
	"textdomain": "hive-core",
	"attributes": {
		"count": {
			"type": "integer",
			"default": 3
		},
		"locationId": {
			"type": "integer",
			"default": 0
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": [ "wide" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
