{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hive/opening-hours",
	"version": "0.1.0",
	"title": "Opening Hours",
	"category": "widgets",
	"icon": "clock",
	"description": "Weekly opening hours of a location, with today highlighted. On a space, shows its location's hours.",
	"keywords": [ "hours", "open", "schedule" ],
	"textdomain": "hive-core",
	"attributes": {
		"locationId": {
			"type": "integer",
			"default": 0
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
